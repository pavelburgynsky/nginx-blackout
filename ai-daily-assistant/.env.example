# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# AI/LLM Configuration (выберите один или несколько)
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Выбор основного AI провайдера (openai или anthropic)
AI_PROVIDER=anthropic

# Google Calendar API
GOOGLE_CALENDAR_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=config/google_token.json

# iTop Configuration
ITOP_URL=https://your-itop-instance.com
ITOP_API_KEY=your_itop_api_key_here
ITOP_USERNAME=your_username
ITOP_PASSWORD=your_password

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_assistant
# Или для SQLite (для тестирования)
# DATABASE_URL=sqlite:///./ai_assistant.db

# Application Settings
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Task Planning Settings
WORK_START_TIME=09:00
WORK_END_TIME=18:00
DEFAULT_TASK_DURATION=30
BREAK_DURATION=15
LUNCH_DURATION=60
